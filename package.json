{
  "name": "wolfari",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "pnpm --filter @wolfari/common build && pnpm -r --parallel --filter ./apps/* dev",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}

